# Web server inside the production image (see Dockerfile). Plain HTTP on :8080: HTTPS, HSTS, compression and the
# Cloudflare-only rule live in the server's front Caddy. App-specific headers and caching stay here, versioned with
# the code.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# PLAY ONLINE needs the microphone (voice chat) and tab capture (the host's picture); nothing else.
		Permissions-Policy "camera=(), geolocation=(), microphone=(self), display-capture=(self)"
		# Three.js, Phaser and Web Audio from the bundle; Google Fonts from index.html; no inline scripts.
		# connect-src: PLAY ONLINE asks PeerJS's public service (0.peerjs.com) for an id and a signalling socket
		# before the two browsers talk directly over WebRTC, which CSP does not govern.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://0.peerjs.com wss://0.peerjs.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Only Vite's content-hashed output is immutable; models, textures and audio under public/ keep their names when
	# replaced, so a year-long immutable cache would pin returning visitors to the old file.
	@static path /assets/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	@media path *.glb *.gltf *.bin *.mp3 *.ogg *.wav *.webp *.png *.jpg *.jpeg *.json
	header @media Cache-Control "public, max-age=3600"
	@html path / /index.html /version.txt
	header @html Cache-Control "no-cache"

	# healthcheck for Docker and the deploy script's automatic rollback
	handle /health {
		respond "ok" 200
	}
	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}
