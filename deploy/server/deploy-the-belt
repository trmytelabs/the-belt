#!/usr/bin/env bash
# Puts one build of The Belt live on this server. Runs as root (through sudo from deploy-the-belt-gate when the
# pipeline deploys, or by hand):
#
#   deploy-the-belt <commit sha> < the-belt-site.tar.gz
#
# Reads a gzipped tar of the site bundle from stdin (Dockerfile, deploy/container.Caddyfile and the built dist/, as
# the deploy workflow packs it), builds ghcr.io/trmytelabs/the-belt:<sha> from it, replaces the running container,
# waits for the new one's healthcheck and checks that it serves <sha>; if that fails, the previous image goes back.
# Exits 0 only when <sha> is live. deploy/server/setup.sh installs this as /usr/local/bin/deploy-the-belt.
set -euo pipefail

NAME=the-belt
IMAGE=ghcr.io/trmytelabs/the-belt
# Loopback only: the server's Caddy proxies thebelt.patchnotes.ca to this port (setup.sh writes that site block).
PORT=${THE_BELT_PORT:-8081}
SHA=${1:-}
[[ "$SHA" =~ ^[0-9a-f]{40}$ ]] || { echo "usage: deploy-the-belt <40-hex commit sha> < the-belt-site.tar.gz" >&2; exit 2; }
TAG="$IMAGE:$SHA"
log() { echo "[deploy-the-belt] $*"; }

start_container() {
  docker run -d --name "$NAME" --restart unless-stopped \
    --read-only --tmpfs /tmp --cap-drop ALL --security-opt no-new-privileges:true \
    --log-opt max-size=10m --log-opt max-file=3 \
    -p "127.0.0.1:$PORT:8080" "$1" >/dev/null
}

# The image's HEALTHCHECK polls every 10 s with 6 retries; allow 90 s before calling it dead.
wait_healthy() {
  local i status
  for i in $(seq 1 90); do
    status=$(docker inspect -f '{{.State.Health.Status}}' "$NAME" 2>/dev/null || echo missing)
    case "$status" in
      healthy) return 0 ;;
      unhealthy|missing) return 1 ;;
    esac
    sleep 1
  done
  return 1
}

# Healthy, and serving this very build.
serves_sha() {
  [ "$(curl -sf --max-time 10 "http://127.0.0.1:$PORT/version.txt" | tr -d '[:space:]')" = "$1" ] \
    && curl -sf --max-time 10 -o /dev/null "http://127.0.0.1:$PORT/"
}

work=$(mktemp -d /tmp/the-belt-deploy.XXXXXX)
trap 'rm -rf "$work"' EXIT
log "receiving the site bundle"
tar -xzf - -C "$work"
[ -f "$work/Dockerfile" ] && [ -f "$work/deploy/container.Caddyfile" ] && [ -f "$work/dist/index.html" ] \
  || { echo "the bundle must hold Dockerfile, deploy/container.Caddyfile and dist/index.html" >&2; exit 1; }
log "building $TAG ($(du -sh "$work/dist" | cut -f1) of site)"
docker build --quiet --build-arg "GIT_SHA=$SHA" -t "$TAG" "$work" >/dev/null

previous=$(docker inspect -f '{{.Config.Image}}' "$NAME" 2>/dev/null || true)
if [ -n "$previous" ]; then
  log "replacing $previous"
  docker rm -f "$NAME" >/dev/null
fi
start_container "$TAG"
if wait_healthy && serves_sha "$SHA"; then
  log "$SHA is live on 127.0.0.1:$PORT"
  # keep the image that just went out and the one before it; drop older builds
  docker images "$IMAGE" --format '{{.Repository}}:{{.Tag}}' | grep -v -e "^$TAG\$" -e "^${previous:-none}\$" \
    | xargs -r docker rmi >/dev/null 2>&1 || true
  exit 0
fi

log "new container never became healthy or does not serve $SHA; its last log lines:"
docker logs --tail 40 "$NAME" 2>&1 | sed 's/^/    /' || true
docker rm -f "$NAME" >/dev/null 2>&1 || true
if [ -n "$previous" ] && [ "$previous" != "$TAG" ]; then
  start_container "$previous"
  if wait_healthy; then log "rolled back to $previous"; else log "ROLLBACK FAILED: $previous is not healthy either"; fi
fi
exit 1
